# Copy to .env (gitignored) and fill with your Entra app registration values.
# These are public-client IDs / endpoints (not secrets), but keep them out of git for this project.
#
# Used by `pnpm dev` at runtime and embedded into executables at `pnpm dist` / build time.
# Never put Cosms or storage account keys here.

YAADEIN_ENTRA_CLIENT_ID=
YAADEIN_ENTRA_TENANT_ID=

# Cosmos (no account keys — user token + RBAC)
YAADEIN_COSMOS_ENDPOINT=https://yaadein-cosmos-dev.documents.azure.com:443/
YAADEIN_COSMOS_DATABASE=yaadein
YAADEIN_COSMOS_CONTAINER=media

# Blob (no account keys — user token + RBAC)
YAADEIN_BLOB_ACCOUNT_URL=https://yaadeinblob.blob.core.windows.net
YAADEIN_BLOB_CONTAINER=media
